import { Theme, UISize, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Navigate } from "../../gen/navigate.slint";
import { SeedState, Actions } from "../../globals.slint";
import { PageBody, NavHeader, Subtext } from "../../components.slint";

export component OverviewPagePage inherits PageBody {

    NavHeader {
        title: SeedState.format-label;
        back => {
            Navigate.backward();
        }
    }

    Subtext {
        text: "Mark out a " + SeedState.qr-width + " by " + SeedState.qr-width + " grid, and leave a clear border around it.";
    }

    Rectangle {
        width: 100%;
        height: self.width;
        background: #ffffff;
        border-radius: Theme.radius-md;

        Image {
            width: parent.width - 16px;
            height: parent.height - 16px;
            x: 8px;
            y: 8px;
            source: SeedState.qr-preview;
            image-rendering: pixelated;
            image-fit: contain;
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }

    Button {
        width: 100%;
        text: "Start Transcribing";
        size: ControlSize.md;
        full-width: true;
        clicked => {
            Navigate.transcribe-page({ });
        }
    }
}
