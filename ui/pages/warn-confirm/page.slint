import { Theme, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Navigate } from "../../gen/navigate.slint";
import { SeedState, Actions, Fonts } from "../../globals.slint";
import { PageBody, NavHeader, Subtext } from "../../components.slint";

export component WarnConfirmPagePage inherits PageBody {
    NavHeader {
        // TODO: localize
        title: "Protect Your Parts";
        back => {
            Navigate.backward();
        }
    }

    Subtext {
        // TODO: localize
        text: "2 of 2: Plan your backups";
    }

    Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: Theme.spacing-md;

            Card {
                width: 100%;
                size: ControlSize.md;
                // TODO: localize
                title: "Each part is a seed";
                // TODO: localize
                body: "Each part is a valid seed for a separate wallet. A single part cannot recover your original wallet.";
            }

            Card {
                width: 100%;
                size: ControlSize.md;
                // TODO: localize
                title: "Keep every part safe";
                // TODO: localize
                body: "Store the parts separately. Check every backup before relying on it.";
            }

            if (SeedState.entry-error != ""): Text {
                text: SeedState.entry-error;
                color: Theme.palette-danger;
                font-family: Theme.font-primary;
                font-size: Fonts.xs;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    Button {
        width: 100%;
        height: Theme.control-size-md;
        // TODO: localize
        text: "Split Seed";
        size: ControlSize.md;
        full-width: true;
        clicked => {
            if (Actions.do-split()) {
                Navigate.parts-page({ });
            }
        }
    }
}
