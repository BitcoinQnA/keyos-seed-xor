import { Theme, UISize, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Navigate } from "../gen/navigate.slint";
import { SeedState, Actions, Fonts } from "../globals.slint";
import { PageBody, TitleText, Subtext } from "../components.slint";

export component MainPagePage inherits PageBody {
    TitleText {
        text: "Seed XOR";
    }

    Subtext {
        text: "Split one seed into parts that are seeds themselves, and put them back together.";
    }

    Card {
        width: 100%;
        size: ControlSize.lg;
        title: "Every part is needed";
        body: "There is no threshold here. All the parts rebuild the seed; any smaller number of them rebuilds a different seed, with no warning that it is the wrong one.";
    }

    Card {
        width: 100%;
        size: ControlSize.md;
        title: "Nothing is saved";
        body: "Seeds and parts are held in memory only while this app is open. They are never written to this device, and this app cannot read seeds stored in Seed Vault.";
    }

    Rectangle {
        vertical-stretch: 1;
    }

    Button {
        width: 100%;
        text: "Split a Seed";
        size: ControlSize.md;
        full-width: true;
        clicked => {
            Actions.start-split();
            Navigate.load-page({ });
        }
    }

    Button {
        width: 100%;
        text: "Combine Parts";
        variant: ButtonVariant.secondary;
        size: ControlSize.md;
        full-width: true;
        clicked => {
            Actions.start-combine();
            Navigate.count-page({ });
        }
    }

    if (SeedState.entry-error != ""): Text {
        text: SeedState.entry-error;
        color: Theme.palette-danger;
        font-family: Theme.font-primary;
        font-size: Fonts.xs;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}
