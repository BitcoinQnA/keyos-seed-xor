import { Theme, UISize, ControlSize, ButtonVariant, Images } from "@ui/theme.slint";
import { Fonts } from "globals.slint";
import { Button } from "@ui/button.slint";

// Shared page frame: background and safe-area padding. Pages place their own
// header and subtitle so ordering is never a surprise.
export component PageBody inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-lg + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-md;

        @children
    }
}

// Page title for screens without a NavHeader.
export component TitleText inherits Text {
    color: Theme.palette-foreground;
    font-family: Theme.font-primary;
    font-size: Fonts.lg;
    font-weight: Theme.font-weight-bold;
    horizontal-alignment: center;
    wrap: word-wrap;
}

// Secondary copy under a header. Firmware "sm" size, never smaller.
export component Subtext inherits Text {
    color: Theme.palette-muted;
    font-family: Theme.font-primary;
    font-size: Fonts.sm;
    font-weight: Theme.font-weight-medium;
    horizontal-alignment: center;
    wrap: word-wrap;
}

// Back control plus a title. Every page below the root gets one so there is
// always a way out, including a way back to the welcome page to scan instead.
//
// `icon_set_ui2.bin` is a device file rather than something the SDK bundle
// ships, so `Images.icon` can come back empty. A missing glyph here would mean
// an invisible way out, so the chevron falls back to a text character.
export component NavHeader inherits Rectangle {
    in property <string> title;
    callback back();

    property <image> back-icon: Images.icon("chevron-left", 28px);

    height: 44px;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;

        touch-target := Rectangle {
            width: 56px;
            height: parent.height;

            if root.back-icon.width > 0: Image {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 28px;
                source: root.back-icon;
                colorize: area.pressed ? Theme.palette-muted : Theme.palette-foreground;
            }

            if root.back-icon.width == 0: Text {
                x: 0px;
                width: 28px;
                height: parent.height;
                text: "\u{2039}";
                color: area.pressed ? Theme.palette-muted : Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: 34px;
                font-weight: Theme.font-weight-medium;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            area := TouchArea {
                // Reaches past the glyph so the tap target clears 44px.
                x: -8px;
                y: -4px;
                width: parent.width + 16px;
                height: parent.height + 8px;
                clicked => {
                    root.back();
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.title;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: Fonts.md;
                font-weight: Theme.font-weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Balances the chevron so the title stays centred.
        Rectangle {
            width: 56px;
        }
    }
}

// A text field the app can dismiss.
//
// The SDK Input does not forward `accept-button-text`, so the on-screen keyboard
// gets no confirm key and there is no way to put it away mid-entry. Driving a
// TextInput directly gives us both that key and `clear-focus()`.
export component WordField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <string> accept-text: "Done";
    in-out property <string> value;

    callback changed(string);
    callback accepted();

    public function dismiss() {
        field.clear-focus();
    }

    public function take-focus() {
        field.focus();
    }

    height: label-text.preferred-height + 6px + 52px;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 6px;

        label-text := Text {
            text: root.label;
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Fonts.xs;
            font-weight: Theme.font-weight-medium;
        }

        Rectangle {
            height: 52px;
            background: Theme.palette-surface;
            border-color: field.has-focus ? Theme.palette-primary : Theme.palette-border;
            border-width: field.has-focus ? Theme.border-width-focus : Theme.border-width-sm;
            border-radius: Theme.radius-md;

            Rectangle {
                x: Theme.spacing-lg;
                width: parent.width - Theme.spacing-lg * 2;
                height: parent.height;
                clip: true;

                if root.value == "": Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.placeholder;
                    color: Theme.palette-muted;
                    font-family: Theme.font-primary;
                    font-size: Fonts.md;
                    vertical-alignment: center;
                }

                field := TextInput {
                    width: parent.width;
                    height: parent.height;
                    text <=> root.value;
                    color: Theme.palette-foreground;
                    font-family: Theme.font-primary;
                    font-size: Fonts.md;
                    vertical-alignment: center;
                    single-line: true;
                    accept-button-text: root.accept-text;

                    edited => {
                        root.changed(self.text);
                    }

                    accepted => {
                        root.accepted();
                    }
                }
            }
        }
    }
}

// Seed word pill, matching the firmware seed word view: 56px tall, pill shaped,
// 22px Montserrat, index in a fixed left column. See KeyOS
// ui/ui/widgets/seed-words.slint.
//
// The fill is the firmware's `Palette.background-pressed`, which is neutral-800
// in dark and neutral-100 in light. No ui2 token resolves to that pair, and
// `palette-card` is the same colour as the page in dark, which renders the pill
// invisible. So the two values are named directly, from KeyOS
// ui/ui/palettes/{dark,light}-palette.slint.
export component WordPill inherits Rectangle {
    in property <int> number;
    in property <string> word;
    in property <bool> highlight;
    callback clicked();

    property <color> fill: Theme.is-dark ? #5a595a : #e3e2e2;

    height: 56px;
    background: root.highlight ? Theme.palette-primary : root.fill;
    border-radius: self.height / 2;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        alignment: start;
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-lg;
        spacing: Theme.spacing-xs;

        Text {
            width: 32px;
            text: root.number + ".";
            color: root.highlight ? Theme.palette-foreground : Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: 22px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        Text {
            text: root.word;
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: 22px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
}
